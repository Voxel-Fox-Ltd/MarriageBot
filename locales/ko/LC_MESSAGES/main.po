#. TRANSLATORS: Command name
#: customisation.py:107
msgid "customize-tree"
msgstr "트리 사용자 지정"

#. TRANSLATORS: Command description
#: customisation.py:109
msgid "Customize the look of your family trees."
msgstr "가족 나무의 디자인을 직접 꾸며보세요."

#: customisation.py:187
#, python-brace-format
msgid ""
"You can't customise someone else's tree! You can customise your own by "
"running the {cusomise_command} command :3"
msgstr ""
"다른 사람의 트리는 수정할 수 없어요! {cusomise_command} 명령어를 실행하면 본"
"인의 트리를 수정할 수 있어요 :3"

#: customisation.py:208
msgid "Customise your tree"
msgstr "나무를 나만의 스타일로 꾸미세요"

#: customisation.py:213
msgid "New value"
msgstr "새로운 값"

#: customisation.py:241
msgid "I don't know what colour that is..."
msgstr "그게 무슨 색인지 모르겠네요..."

#. TRANSLATORS: Command option name (/force marry [user1] [user2])
#. TRANSLATORS: Command option name (/force divorce [user1] [user2])
#. TRANSLATORS: Command option name (/force adopt [user1] [user2])
#: force_commands.py:43 force_commands.py:122 force_commands.py:213
msgid "user1"
msgstr "사용자1"

#. TRANSLATORS: Command option name description
#: force_commands.py:45
msgid "The first user that you want to set up to marry."
msgstr "결혼 상대로 설정하려는 첫 번째 사용자."

#. TRANSLATORS: Command option name (/force marry [user1] [user2])
#. TRANSLATORS: Command option name (/force divorce [user1] [user2])
#. TRANSLATORS: Command option name (/force adopt [user1] [user2])
#: force_commands.py:53 force_commands.py:133 force_commands.py:223
msgid "user2"
msgstr "사용자2"

#. TRANSLATORS: Command option name description
#: force_commands.py:55
msgid "The second user that you want to set up to marry."
msgstr "결혼 상대로 설정하려는 두 번째 사용자입니다."

#. TRANSLATORS: Command name
#: force_commands.py:59
msgid "force marry"
msgstr "강제 결혼"

#. TRANSLATORS: Command description
#: force_commands.py:61
msgid "Force two users to marry each other."
msgstr "두 사용자가 서로 결혼하도록 강제한다."

#: force_commands.py:89
msgid "You can't marry someone to themself :/"
msgstr "누군가를 그 사람 자신과 결혼시킬 수는 없잖아 :/"

#: force_commands.py:101
#, python-brace-format
msgid "Done! Married {user1} and {user2} :3"
msgstr "끝! 결혼했어요 {user1}과 {user2} :3"

#: force_commands.py:125
msgid "The first user that you want to set up to divorce."
msgstr "이혼 절차를 진행하려는 첫 번째 사용자입니다."

#: force_commands.py:136
msgid "The second user that you want to set up to divorce."
msgstr "이혼 절차를 밟도록 설정하려는 두 번째 사용자입니다."

#. TRANSLATORS: Command name
#: force_commands.py:141
msgid "force divorce"
msgstr "강제 이혼"

#. TRANSLATORS: Command description
#: force_commands.py:143
msgid "Force two users to divorce each other."
msgstr "두 사용자가 서로 이혼하도록 강제한다."

#: force_commands.py:193
#, python-brace-format
msgid "Done! {user1} and {user2} are now divorced :3"
msgstr "끝! {user1}과 {user2}은 이제 이혼했어요 :3"

#. TRANSLATORS: Command option name description
#: force_commands.py:215
msgid "The child for the adoption"
msgstr "입양 대상 아동"

#. TRANSLATORS: Command option name description
#: force_commands.py:225
msgid "The parent for the adoption."
msgstr "입양을 위한 양부모."

#. TRANSLATORS: Command name
#: force_commands.py:229
msgid "force adopt"
msgstr "강제로 채택하다"

#. TRANSLATORS: Command description
#: force_commands.py:231
msgid "Force one user to adopt another."
msgstr "한 사용자가 다른 사용자를 강제로 채택하도록 한다."

#: force_commands.py:259
msgid "You can't adopt someone to themself :/"
msgstr "누군가를 그 사람 본래의 모습 그대로 입양할 수는 없어요 :/"

#: force_commands.py:286
#, python-brace-format
msgid "Done! {user1} is now a child of {user2} :3"
msgstr "완료! {user1}이 이제 {user2}의 자식이 되었습니다 :3"

