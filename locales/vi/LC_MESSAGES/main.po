#. TRANSLATORS: Command name
#: information.py:41
msgid "relationship"
msgstr "mối quan hệ"

#. TRANSLATORS: Command description
#: information.py:43
msgid "Get the relationship between two users."
msgstr "Lấy thông tin về mối quan hệ giữa hai người dùng."

#. TRANSLATORS: Command option description (/relationship [user] [other])
#: information.py:51
msgid "The first user who you want to check the relation of."
msgstr "Người dùng đầu tiên mà bạn muốn kiểm tra mối quan hệ."

#. TRANSLATORS: Command option name (/relationship [user] [other])
#: information.py:58
msgid "other"
msgstr "khác"

#. TRANSLATORS: Command option description (/relationship [user] [other])
#: information.py:60
msgid "The second user who you want to compare the first to."
msgstr "Người dùng thứ hai mà bạn muốn so sánh với người dùng thứ nhất."

#: information.py:92
#, python-brace-format
msgid "**{user}** is not related to **{other}**."
msgstr "**{user}** không liên quan đến **{other}**."

#: information.py:102
#, python-brace-format
msgid "**{user}** is **{other}**'s **{relation}**."
msgstr "**{user}** là **{relation}** của **{other}**."

