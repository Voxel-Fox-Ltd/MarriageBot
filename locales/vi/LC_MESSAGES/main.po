msgstr "{user} là phần tử cha của:"

#. TRANSLATORS: Command name
#: information.py:292
msgid "parent"
msgstr "phụ huynh"

#. TRANSLATORS: Command option name description (/parent [user])
#: information.py:301
msgid "The user whose parent you want to see."
msgstr "Người dùng mà bạn muốn xem thông tin cha mẹ của họ."

#. TRANSLATORS: Command description
#: information.py:306
msgid "Show you the parent for a user."
msgstr "Hiển thị thông tin cha mẹ của một người dùng."

#: information.py:334
