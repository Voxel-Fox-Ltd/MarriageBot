#: information.py:390
msgid "familysize"
msgstr "kích cỡ gia đình"

#. TRANSLATORS: Command description (/familysize)
#: information.py:392
msgid "Get the family size of another user."
msgstr "Lấy thông tin về quy mô gia đình của một người dùng khác."

#: information.py:411
#, python-brace-format
msgid ""
"There is **{number}** person in {user}'s family tree, including all blood "
"and non-blood relatives."
msgid_plural ""
"There are **{number}** people in {user}'s family tree, including all blood "
"and non-blood relatives."
msgstr[0] ""
"Trong cây gia phả của {user} có **{number}** người, bao gồm cả họ hàng ruột "
"thịt và họ hàng không ruột thịt."

#. TRANSLATORS: Command name (/tree)
#: information.py:419
msgid "tree"
msgstr "cây"

#: information.py:427 information.py:453
msgid "The user whose tree you want to see."
msgstr "Người dùng mà bạn muốn xem cây của họ."

#: information.py:431
msgid "Show your family tree, but only blood relatives :3"
msgstr ""
"Hãy chia sẻ cây gia phả của bạn, nhưng chỉ bao gồm những người thân ruột "
"thịt thôi nhé :3"

#. TRANSLATORS: Command name (/fulltree)
#: information.py:445
msgid "fulltree"
msgstr "cây toàn phần"

#: information.py:457
msgid "Show your entire family tree, including non-blood relatives :3"
msgstr ""
"Hãy hiển thị toàn bộ cây gia phả của bạn, bao gồm cả những người không có "
"quan hệ huyết thống :3"

#: information.py:472 subscriber_commands.py:47
#, python-brace-format
msgid ""
"You need to be a higher tier subscriber to run this command! You can still "
"use {non_perks_command} though :3"
msgstr ""
"Bạn cần phải là thành viên cấp cao hơn mới có thể thực hiện lệnh này! Tuy "
"nhiên, bạn vẫn có thể sử dụng {non_perks_command} :3"

#: information.py:501
msgid "You have no family to put into a tree .-."
msgstr "Bạn không có người thân nào để thêm vào cây gia phả cả .-."

#: information.py:508
#, python-brace-format
msgid "{user} has no family to put into a tree .-."
msgstr "{user} không có gia đình nào để đưa vào cây gia phả .-."

#: information.py:578
msgid ""
"I couldn't send your family tree image - please try again in a few minutes."
msgstr ""
"Tôi không thể gửi hình ảnh cây gia phả của bạn - vui lòng thử lại sau vài "
"phút."

#: information.py:587
#, python-brace-format
msgid ""
"Use {fulltree} for your *entire* family, including non-blood relatives.\n"
"Use {customize} to change how your tree looks."
msgstr ""
"Sử dụng {fulltree} cho *toàn bộ* gia đình của bạn, bao gồm cả những người "
"không có quan hệ huyết thống.\n"
"Sử dụng {customize} để thay đổi giao diện của cây gia phả."

#. TRANSLATORS: Command name
#: marriage.py:33
msgid "marry"
msgstr "kết hôn"

#. TRANSLATORS: Command option name description (/marry user)
#: marriage.py:42
