msgid "Propose to another user."
msgstr "Gửi lời mời kết bạn đến một người dùng khác."

#: marriage.py:58
#, python-brace-format
msgid "Hey {user}, {author} wants to marry you! What do you say?"
msgstr "Này {user}, {author} muốn cưới bạn đấy! Bạn nghĩ sao?"

#. TRANSLATORS: Command name
#: marriage.py:64
msgid "divorce"
msgstr "ly hôn"

#. TRANSLATORS: Command description
#: marriage.py:66
msgid "Divorce one of your partners."
msgstr "Ly hôn với một trong hai người bạn đời của bạn."

#: marriage.py:94
