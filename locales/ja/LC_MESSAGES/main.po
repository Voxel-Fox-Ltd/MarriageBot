msgstr "最初に離婚手続きを行うユーザー。"

#: force_commands.py:136
msgid "The second user that you want to set up to divorce."
msgstr "離婚手続きを行う2人目のユーザーだ。"

#. TRANSLATORS: Command name
#: force_commands.py:141
msgid "force divorce"
msgstr "強制 離婚"

#. TRANSLATORS: Command description
#: force_commands.py:143
msgid "Force two users to divorce each other."
msgstr "2人のユーザーに強制的に離婚させる。"

#: force_commands.py:193
#, python-brace-format
msgid "Done! {user1} and {user2} are now divorced :3"
msgstr "完了！ {user1}と{user2}は離婚した :3"

#. TRANSLATORS: Command option name description
#: force_commands.py:215
msgid "The child for the adoption"
msgstr "養子縁組の対象となる子供"

#. TRANSLATORS: Command option name description
#: force_commands.py:225
msgid "The parent for the adoption."
msgstr "養子縁組の親。"

#. TRANSLATORS: Command name
#: force_commands.py:229
msgid "force adopt"
msgstr "強制 養子"

#. TRANSLATORS: Command description
#: force_commands.py:231
msgid "Force one user to adopt another."
msgstr "あるユーザーに別のユーザーを強制的に割り当てる。"

#: force_commands.py:259
msgid "You can't adopt someone to themself :/"
msgstr "誰かをその人自身として養子にすることはできない :/"

#: force_commands.py:286
#, python-brace-format
msgid "Done! {user1} is now a child of {user2} :3"
msgstr "完了！ {user1} は {user2} の子になった :3"

