#, python-brace-format
msgid "**{user}** is not related to **{other}**."
msgstr "**{user}**は**{other}**とは関係がない。"

#: information.py:102
#, python-brace-format
msgid "**{user}** is **{other}**'s **{relation}**."
msgstr "**{user}**は**{other}**の**{relation}**だ。"

