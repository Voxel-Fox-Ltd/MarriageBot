#. TRANSLATORS: Command name (/fulltree)
#: information.py:445
msgid "fulltree"
msgstr "fulltree"

#: information.py:457
msgid "Show your entire family tree, including non-blood relatives :3"
msgstr ""
"Affiche ton arbre généalogique complet, y compris les parents qui ne sont "
"pas de sang :3"

#: information.py:472 subscriber_commands.py:47
#, python-brace-format
msgid ""
"You need to be a higher tier subscriber to run this command! You can still "
"use {non_perks_command} though :3"
msgstr ""
"Tu dois être abonné à un niveau supérieur pour utiliser cette commande ! Tu "
"peux quand même utiliser {non_perks_command} :3"

#: information.py:501
msgid "You have no family to put into a tree .-."
msgstr "Tu n'as personne à ajouter à ton arbre généalogique .-."

#: information.py:508
#, python-brace-format
msgid "{user} has no family to put into a tree .-."
msgstr "{user} n'a pas de famille à ajouter à l'arbre .-."

#: information.py:578
msgid ""
"I couldn't send your family tree image - please try again in a few minutes."
msgstr ""
"Je n'ai pas pu envoyer l'image de ton arbre généalogique. Essaie à nouveau "
"dans quelques minutes."

#: information.py:587
#, python-brace-format
msgid ""
"Use {fulltree} for your *entire* family, including non-blood relatives.\n"
"Use {customize} to change how your tree looks."
msgstr ""
"Utilise {fulltree} pour *toute* ta famille, y compris les personnes qui ne "
"sont pas de la même famille.\n"
"Utilise {customize} pour modifier l'apparence de ton arbre généalogique."

