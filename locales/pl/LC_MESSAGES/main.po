msgid "The user whose tree you want to see."
msgstr "Użytkownik, którego drzewo chcesz obejrzeć."

#: information.py:431
msgid "Show your family tree, but only blood relatives :3"
msgstr "Pokaż swoje drzewo genealogiczne, ale tylko krewnych :3"

#. TRANSLATORS: Command name (/fulltree)
#: information.py:445
msgid "fulltree"
msgstr "fulltree"

#: information.py:457
msgid "Show your entire family tree, including non-blood relatives :3"
msgstr ""
"Pokaż całe swoje drzewo genealogiczne, łącznie z krewnymi, z którymi nie "
"łączą cię więzy krwi :3"

#: information.py:472 subscriber_commands.py:47
#, python-brace-format
msgid ""
"You need to be a higher tier subscriber to run this command! You can still "
"use {non_perks_command} though :3"
msgstr ""
"Aby uruchomić to polecenie, musisz mieć wyższy poziom subskrypcji! Ale nadal "
"możesz używać {non_perks_command} :3"

#: information.py:501
msgid "You have no family to put into a tree .-."
msgstr ""
"Nie masz nikogo z rodziny, kogo mógłbyś wpisać do drzewa genealogicznego .-."

#: information.py:508
#, python-brace-format
msgid "{user} has no family to put into a tree .-."
msgstr "{user} nie ma rodziny, którą można by umieścić w drzewie .-."

#: information.py:578
msgid ""
"I couldn't send your family tree image - please try again in a few minutes."
msgstr ""
"Nie udało mi się wysłać zdjęcia twojego drzewa genealogicznego – spróbuj "
"ponownie za kilka minut."

#: information.py:587
#, python-brace-format
msgid ""
"Use {fulltree} for your *entire* family, including non-blood relatives.\n"
"Use {customize} to change how your tree looks."
msgstr ""
"Wpisz {fulltree}, jeśli chodzi o *całą* rodzinę, w tym osoby spoza "
"najbliższej rodziny.\n"
"Wpisz {customize}, żeby zmienić wygląd swojego drzewa genealogicznego."

