msgstr[1] ""
msgstr[2] ""

#. TRANSLATORS: Command name (/tree)
#: information.py:419
msgid "tree"
msgstr "дерево"

#: information.py:427 information.py:453
msgid "The user whose tree you want to see."
msgstr "Користувач, дерево якого ви хочете переглянути."

#: information.py:431
msgid "Show your family tree, but only blood relatives :3"
msgstr "Покажи своє родинне дерево, але тільки кровних родичів :3"

#. TRANSLATORS: Command name (/fulltree)
#: information.py:445
msgid "fulltree"
msgstr "fulltree"

#: information.py:457
msgid "Show your entire family tree, including non-blood relatives :3"
msgstr ""
"Покажіть своє генеалогічне дерево, включаючи родичів, з якими вас не "
"пов'язують кровні узи :3"

#: information.py:472 subscriber_commands.py:47
#, python-brace-format
msgid ""
"You need to be a higher tier subscriber to run this command! You can still "
"use {non_perks_command} though :3"
msgstr ""
"Щоб виконати цю команду, вам потрібно мати підписку вищого рівня! Але ви все "
"одно можете використовувати {non_perks_command} :3"

#: information.py:501
msgid "You have no family to put into a tree .-."
msgstr "У тебе немає родичів, яких можна внести до генеалогічного дерева .-."

#: information.py:508
#, python-brace-format
msgid "{user} has no family to put into a tree .-."
msgstr "{user} не має родичів, яких можна було б внести до дерева .-."

#: information.py:578
msgid ""
"I couldn't send your family tree image - please try again in a few minutes."
msgstr ""
"Мені не вдалося надіслати зображення вашого генеалогічного дерева — "
"спробуйте ще раз через кілька хвилин."

#: information.py:587
#, python-brace-format
msgid ""
"Use {fulltree} for your *entire* family, including non-blood relatives.\n"
"Use {customize} to change how your tree looks."
msgstr ""
"Виберіть {fulltree} для *всієї* вашої родини, включаючи родичів, які не є "
"кровними родичами.\n"
"Виберіть {customize}, щоб змінити вигляд вашого генеалогічного дерева."

