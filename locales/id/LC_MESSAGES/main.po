#: information.py:411
#, python-brace-format
msgid ""
"There is **{number}** person in {user}'s family tree, including all blood "
"and non-blood relatives."
msgid_plural ""
"There are **{number}** people in {user}'s family tree, including all blood "
"and non-blood relatives."
msgstr[0] ""
"Ada **{number}** orang dalam silsilah keluarga {user}, termasuk semua "
"kerabat kandung dan non-kandung."

#. TRANSLATORS: Command name (/tree)
#: information.py:419
msgid "tree"
msgstr "pohon"

#: information.py:427 information.py:453
msgid "The user whose tree you want to see."
msgstr "Pengguna yang pohonnya ingin Anda lihat."

#: information.py:431
msgid "Show your family tree, but only blood relatives :3"
msgstr "Tampilkan silsilah keluargamu, tapi hanya kerabat sedarah :3"

#. TRANSLATORS: Command name (/fulltree)
#: information.py:445
msgid "fulltree"
msgstr "pohon lengkap"

#: information.py:457
msgid "Show your entire family tree, including non-blood relatives :3"
msgstr ""
"Tampilkan silsilah keluarga Anda secara lengkap, termasuk kerabat yang tidak "
"memiliki hubungan darah :3"

#: information.py:472 subscriber_commands.py:47
#, python-brace-format
msgid ""
"You need to be a higher tier subscriber to run this command! You can still "
"use {non_perks_command} though :3"
msgstr ""
"Kamu harus menjadi pelanggan tingkat yang lebih tinggi untuk menjalankan "
"perintah ini! Tapi kamu tetap bisa menggunakan {non_perks_command} kok :3"

#: information.py:501
msgid "You have no family to put into a tree .-."
msgstr "Kamu tidak punya keluarga untuk dimasukkan ke dalam pohon silsilah .-."

#: information.py:508
#, python-brace-format
msgid "{user} has no family to put into a tree .-."
msgstr ""
"{user} tidak memiliki keluarga yang bisa dimasukkan ke dalam pohon "
"silsilah .-."

#: information.py:578
msgid ""
"I couldn't send your family tree image - please try again in a few minutes."
msgstr ""
"Saya tidak bisa mengirim gambar silsilah keluarga Anda — silakan coba lagi "
"beberapa menit lagi."

#: information.py:587
#, python-brace-format
msgid ""
"Use {fulltree} for your *entire* family, including non-blood relatives.\n"
"Use {customize} to change how your tree looks."
msgstr ""
"Gunakan {fulltree} untuk *seluruh* keluarga Anda, termasuk kerabat yang "
"tidak memiliki hubungan darah.\n"
"Gunakan {customize} untuk mengubah tampilan pohon silsilah Anda."

