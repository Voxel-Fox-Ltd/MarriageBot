#. TRANSLATORS: Command name
#: customisation.py:107
msgid "customize-tree"
msgstr "sesuaikan-pohon"

#. TRANSLATORS: Command description
#: customisation.py:109
msgid "Customize the look of your family trees."
msgstr "Sesuaikan tampilan silsilah keluarga Anda."

#: customisation.py:187
#, python-brace-format
msgid ""
"You can't customise someone else's tree! You can customise your own by "
"running the {cusomise_command} command :3"
msgstr ""
"Kamu tidak bisa menyesuaikan pohon milik orang lain! Kamu bisa menyesuaikan "
"pohonmu sendiri dengan menjalankan perintah {cusomise_command} :3"

#: customisation.py:208
msgid "Customise your tree"
msgstr "Sesuaikan pohon Anda"

#: customisation.py:213
msgid "New value"
msgstr "Nilai baru"

