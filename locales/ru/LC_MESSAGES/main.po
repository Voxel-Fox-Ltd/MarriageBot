msgstr "Нельзя выдать кого-то замуж за самого себя :/"

#: force_commands.py:101
#, python-brace-format
msgid "Done! Married {user1} and {user2} :3"
msgstr "Готово! Женился {user1} и {user2} :3"

#: force_commands.py:125
msgid "The first user that you want to set up to divorce."
msgstr "Первый пользователь, для которого ты хочешь настроить развод."

