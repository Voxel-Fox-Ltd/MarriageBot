msgstr "Пользователь, чью структуру ты хочешь посмотреть."

#: information.py:431
msgid "Show your family tree, but only blood relatives :3"
msgstr "Покажи своё генеалогическое древо, но только кровных родственников :3"

#. TRANSLATORS: Command name (/fulltree)
#: information.py:445
msgid "fulltree"
msgstr "полное дерево"

#: information.py:457
msgid "Show your entire family tree, including non-blood relatives :3"
msgstr "Покажи всё своё семейное древо, включая родственников по браку :3"

#: information.py:472 subscriber_commands.py:47
#, python-brace-format
msgid ""
"You need to be a higher tier subscriber to run this command! You can still "
"use {non_perks_command} though :3"
msgstr ""
"Чтобы выполнить эту команду, тебе нужен абонемент более высокого уровня! Но "
"ты всё равно можешь использовать {non_perks_command} :3"

#: information.py:501
msgid "You have no family to put into a tree .-."
msgstr ""
"У тебя нет родственников, которых можно было бы внести в родословную .-."

#: information.py:508
#, python-brace-format
msgid "{user} has no family to put into a tree .-."
msgstr ""
"{user} у него нет родственников, которых можно было бы добавить в дерево .-."

#: information.py:578
msgid ""
"I couldn't send your family tree image - please try again in a few minutes."
msgstr ""
"Мне не удалось отправить изображение твоего генеалогического дерева — "
"попробуй ещё раз через несколько минут."

#: information.py:587
#, python-brace-format
msgid ""
"Use {fulltree} for your *entire* family, including non-blood relatives.\n"
"Use {customize} to change how your tree looks."
msgstr ""
"Используй {fulltree} для *всей* твоей семьи, включая родственников, не "
"связанных кровным родством.\n"
"Используй {customize}, чтобы изменить вид своего дерева."

