#. TRANSLATORS: Command name
#: customisation.py:107
msgid "customize-tree"
msgstr "personalizar-árvore"

#. TRANSLATORS: Command description
#: customisation.py:109
msgid "Customize the look of your family trees."
msgstr "Personaliza o visual das tuas árvores genealógicas."

#: customisation.py:187
#, python-brace-format
msgid ""
"You can't customise someone else's tree! You can customise your own by "
"running the {cusomise_command} command :3"
msgstr ""
"Não dá pra personalizar a árvore de outra pessoa! Podes personalizar a tua "
"própria executando o comando {cusomise_command} :3"

#: customisation.py:208
msgid "Customise your tree"
msgstr "Personaliza a tua árvore"

#: customisation.py:213
msgid "New value"
msgstr "Novo valor"

#: customisation.py:241
msgid "I don't know what colour that is..."
msgstr "Não sei que cor é essa..."

