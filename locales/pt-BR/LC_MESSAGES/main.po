msgstr "Mostra a tua árvore genealógica, mas só os parentes de sangue :3"

#. TRANSLATORS: Command name (/fulltree)
#: information.py:445
msgid "fulltree"
msgstr "fulltree"

#: information.py:457
msgid "Show your entire family tree, including non-blood relatives :3"
msgstr ""
"Mostra toda a tua árvore genealógica, incluindo parentes que não são de "
"sangue :3"

#: information.py:472 subscriber_commands.py:47
#, python-brace-format
msgid ""
"You need to be a higher tier subscriber to run this command! You can still "
"use {non_perks_command} though :3"
msgstr ""
"Você precisa ser um assinante de nível superior para executar esse comando! "
"Mas você ainda pode usar o {non_perks_command} :3"

#: information.py:501
msgid "You have no family to put into a tree .-."
msgstr "Você não tem família para colocar na árvore .-."

#: information.py:508
#, python-brace-format
